<Window x:Class="FichaCalc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FichaCalc"
        mc:Ignorable="d"
        Title="FichaCalc"
        Width="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock
            Grid.Row="0"
            Text="FichaCalc"
            FontSize="28"
            FontWeight="Bold"
            HorizontalAlignment="Center"
            Margin="0,0,0,20"/>

        <!-- Nome do material -->
        <StackPanel
    Grid.Row="1"
    Margin="0,0,0,10">

            <TextBlock
        Text="Nome do material"
        FontSize="15"
        FontWeight="SemiBold"
        Margin="0,0,0,5"/>

            <TextBox
        x:Name="txtMaterial"
        Height="34"
        FontSize="16"
        VerticalContentAlignment="Center"
        Padding="8,0"/>

            <TextBlock
        Text="Ex: Cola, Tinta, Solvente."
        Foreground="Gray"
        FontSize="12"
        Margin="2,3,0,0"/>
        </StackPanel>

        <!-- Quantidade da embalagem -->
        <StackPanel
    Grid.Row="2"
    Margin="0,0,0,10">

            <TextBlock
        Text="Quantidade da embalagem"
        FontSize="15"
        FontWeight="SemiBold"
        Margin="0,0,0,5"/>

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ComboBox
            x:Name="cmbUnidade"
            Grid.Column="0"
            Height="34"
            FontSize="15"
            VerticalContentAlignment="Center"
            SelectedIndex="0">

                    <ComboBoxItem Content="ml"/>
                    <ComboBoxItem Content="L"/>
                    <ComboBoxItem Content="g"/>
                    <ComboBoxItem Content="kg"/>
                    <ComboBoxItem Content="m"/>
                    <ComboBoxItem Content="cm"/>
                    <ComboBoxItem Content="un"/>
                </ComboBox>

                <Button
            Grid.Column="1"
            Content="+"
            FontSize="16"
            Margin="5,0"
            Click="BtnAdicionarUnidade_Click"/>

                <Grid Grid.Column="2">

                    <TextBox
                x:Name="txtQuantidade"
                Height="34"
                FontSize="16"
                VerticalContentAlignment="Center"
                Padding="8,0"
                PreviewTextInput="SomenteNumeros_PreviewTextInput"
                TextChanged="TxtQuantidade_TextChanged"/>

                    <TextBlock
                x:Name="placeholderQuantidade"
                Text="0,00"
                Foreground="Gray"
                FontSize="16"
                VerticalAlignment="Center"
                Margin="8,0,0,0"
                IsHitTestVisible="False"/>

                </Grid>

            </Grid>
        </StackPanel>

        <!-- Valor da embalagem -->
        <StackPanel
    Grid.Row="3"
    Margin="0,0,0,10">

            <TextBlock
        Text="Valor da embalagem"
        FontSize="15"
        FontWeight="SemiBold"
        Margin="0,0,0,5"/>

            <Grid>

                <TextBox
            x:Name="txtValor"
            Height="34"
            FontSize="16"
            VerticalContentAlignment="Center"
            Padding="8,0"
            PreviewTextInput="SomenteNumeros_PreviewTextInput"
            TextChanged="TxtValor_TextChanged"/>

                <TextBlock
            x:Name="placeholderValor"
            Text="0,00"
            Foreground="Gray"
            FontSize="16"
            VerticalAlignment="Center"
            Margin="8,0,0,0"
            IsHitTestVisible="False"/>

            </Grid>
        </StackPanel>

        <!-- Quantidade produzida -->
        <StackPanel
    Grid.Row="4"
    Margin="0,0,0,10">

            <TextBlock
        Text="Quantidade produzida"
        FontSize="15"
        FontWeight="SemiBold"
        Margin="0,0,0,5"/>

            <Grid>

                <TextBox
            x:Name="txtProducao"
            Height="34"
            FontSize="16"
            VerticalContentAlignment="Center"
            Padding="8,0"
            PreviewTextInput="SomenteNumeros_PreviewTextInput"
            TextChanged="TxtProducao_TextChanged"/>

                <TextBlock
            x:Name="placeholderProducao"
            Text="0"
            Foreground="Gray"
            FontSize="16"
            VerticalAlignment="Center"
            Margin="8,0,0,0"
            IsHitTestVisible="False"/>

                <TextBlock
            Text="Quantidade total por embalagem."
            Foreground="Gray"
            FontSize="12"
            Margin="0,34,2,-31"/>



            </Grid>
        </StackPanel>

        <!-- Botão calcular -->
        <Button
            Grid.Row="5"
            Content="Calcular"
            Height="40"
            Margin="0,20,0,0"
            Click="BtnCalcular_Click"/>

        <!-- Resultados -->
        <StackPanel Grid.Row="6">

            <TextBlock
                x:Name="txtResultadoConsumo"
                FontSize="16"
                Margin="0,5"/>

            <TextBlock
                x:Name="txtResultadoCusto"
                FontSize="16"
                Margin="0,5"/>

            <TextBlock
                x:Name="txtResultadoRendimento"
                FontSize="16"
                Margin="0,5"/>

        </StackPanel>

    </Grid>

</Window>