<Window x:Class="FichaCalc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FichaCalc"
        mc:Ignorable="d"
        Title="FichaCalc"
        Width="360"
        MinWidth="320"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="24,20,24,24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="FichaCalc"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Custo e rendimento de material"
                       FontSize="12"
                       Foreground="{StaticResource MutedBrush}"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Nome do material -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Nome do material" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="txtMaterial"/>
            <TextBlock Text="Ex: Cola, Tinta, Solvente." Style="{StaticResource FieldHint}"/>
        </StackPanel>

        <!-- Quantidade da embalagem -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Quantidade da embalagem" Style="{StaticResource FieldLabel}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="cmbUnidade"
                          Grid.Column="0"
                          SelectedIndex="0">
                    <ComboBoxItem Content="Ml"/>
                    <ComboBoxItem Content="L"/>
                    <ComboBoxItem Content="G"/>
                    <ComboBoxItem Content="Kg"/>
                    <ComboBoxItem Content="M"/>
                    <ComboBoxItem Content="Mm"/>
                    <ComboBoxItem Content="Un"/>
                </ComboBox>

                <Button Grid.Column="1"
                        Content="+"
                        Style="{StaticResource GhostButton}"
                        Margin="6,0"
                        ToolTip="Adicionar unidade"
                        Click="BtnAdicionarUnidade_Click"/>

                <Grid Grid.Column="2">
                    <TextBox x:Name="txtQuantidade"
                             PreviewTextInput="SomenteNumeros_PreviewTextInput"
                             TextChanged="TxtQuantidade_TextChanged"/>

                    <TextBlock x:Name="placeholderQuantidade"
                               Text="0,00"
                               Style="{StaticResource Placeholder}"/>
                </Grid>
            </Grid>
        </StackPanel>

        <!-- Valor da embalagem -->
        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="Valor da embalagem" Style="{StaticResource FieldLabel}"/>

            <Grid>
                <TextBox x:Name="txtValor"
                         PreviewTextInput="SomenteNumeros_PreviewTextInput"
                         TextChanged="TxtValor_TextChanged"/>

                <TextBlock x:Name="placeholderValor"
                           Text="0,00"
                           Style="{StaticResource Placeholder}"/>
            </Grid>
        </StackPanel>

        <!-- Quantidade produzida -->
        <StackPanel Grid.Row="4" Margin="0,0,0,0">
            <TextBlock Text="Quantidade produzida" Style="{StaticResource FieldLabel}"/>

            <Grid>
                <TextBox x:Name="txtProducao"
                         PreviewTextInput="SomenteNumeros_PreviewTextInput"
                         TextChanged="TxtProducao_TextChanged"/>

                <TextBlock x:Name="placeholderProducao"
                           Text="0"
                           Style="{StaticResource Placeholder}"/>
            </Grid>

            <TextBlock Text="Quantidade total por embalagem." Style="{StaticResource FieldHint}"/>
        </StackPanel>

        <!-- Botão calcular -->
        <Button Grid.Row="5"
                Content="Calcular"
                Style="{StaticResource PrimaryButton}"
                Margin="0,18,0,0"
                Click="BtnCalcular_Click"/>

        <!-- Resultados -->
        <Border Grid.Row="6"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="RESULTADO"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,0,0,4"/>

                <TextBlock x:Name="txtResultadoConsumo"
                           FontSize="13"
                           Foreground="{StaticResource TextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,3"/>

                <TextBlock x:Name="txtResultadoCusto"
                           FontSize="13"
                           Foreground="{StaticResource TextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,3"/>

                <TextBlock x:Name="txtResultadoRendimento"
                           FontSize="13"
                           Foreground="{StaticResource TextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,3"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
